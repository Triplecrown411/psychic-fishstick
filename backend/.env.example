# Copy this file to .env and fill in your values.
# Get APP_ID and DEV_PORTAL_API_KEY from https://developer.worldcoin.org

APP_ID=app_your_app_id_here
DEV_PORTAL_API_KEY=your_dev_portal_api_key_here

# Set to your ngrok URL (or production domain) to restrict CORS.
# Leave unset or set to * to allow all origins (dev only).
ALLOWED_ORIGIN=https://your-ngrok-url.ngrok-free.app
